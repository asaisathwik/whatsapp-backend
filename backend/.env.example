# WhatsApp SaaS Backend Environment Variables
PROJECT_NAME="WhatsApp AI SaaS Platform"
ENVIRONMENT="production"
DEBUG=False

# JWT Secret (Generate a secure random string in production)
SECRET_KEY="replace-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL for cloud, SQLite for local)
DATABASE_URL="sqlite:///./whatsapp_saas.db"

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_MOCK=False

# Evolution / WhatsApp Bridge
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="evolution_api_global_key"
EVOLUTION_USE_MOCK=False

# AI Provider (Optional)
AI_PROVIDER="mock"
OPENAI_API_KEY=""

# Storage
STORAGE_TYPE="local"
STORAGE_LOCAL_DIR="./uploads"

# CORS
CORS_ORIGINS=["http://localhost:3000","https://whatsapp-frontend.vercel.app"]
DEFAULT_COUNTRY_CODE="IN"
