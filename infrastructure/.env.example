# Environment Configuration Example
PROJECT_NAME="WhatsApp AI SaaS Platform"
ENVIRONMENT=production
DEBUG=false

# Security
SECRET_KEY=generate-a-strong-random-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://saas_user:saas_password@localhost:5432/whatsapp_saas_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MOCK=false

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution_api_global_key
EVOLUTION_USE_MOCK=false

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Storage
STORAGE_TYPE=local
S3_BUCKET_NAME=whatsapp-saas-media
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Defaults
DEFAULT_COUNTRY_CODE=IN
